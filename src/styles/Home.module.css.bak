/* Container for the entire page */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  width: 100%; /* Ensure container has a defined width */
}

/* Form styling */
.form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 20px;
}

/* Input container (for URL input and drag-and-drop) */
.inputContainer {
  position: relative;
  width: 100%;
  border: 2px dashed #ccc;
  padding: 10px;
  border-radius: 4px;
  background-color: #f9f9f9;
  cursor: pointer;
}

/* Highlight when dragging */
.inputContainer.dragging {
  border-color: #666;
  background-color: #e0e0e0;
}

/* URL input styling */
.input {
  width: 100%;
  padding: 10px;
  font-size: 16px;
  border: 1px solid #ccc;
  border-radius: 4px;
  box-sizing: border-box;
}

/* Hidden file input */
.fileInput {
  display: none;
}

/* Submit button */
.button {
  padding: 10px 20px;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 16px;
}

.button:disabled {
  background-color: #cccccc;
  cursor: not-allowed;
}

/* Response message */
.responseMessage {
  margin: 10px 0;
  color: #333;
}

/* Response section */
.response {
  margin-top: 20px;
}

/* Crop section */
.cropSection {
  margin-top: 20px;
  padding: 20px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

.cropSection h2 {
  margin-bottom: 10px;
}

.cropSection div {
  margin-bottom: 10px;
}

.cropSection label {
  margin-right: 10px;
}

.cropSection input {
  padding: 5px;
  border: 1px solid #ccc;
  border-radius: 4px;
  width: 100px;
}

/* Loading state */
.loading {
  text-align: center;
  padding: 20px;
  font-size: 18px;
  color: #666;
}

/* Recent Videos Section */
.recentVideos {
  margin-top: 40px;
}

.videoGrid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
}

.videoCard {
  text-decoration: none;
  color: inherit;
}

.thumbnailContainer {
  position: relative;
  width: 200px; /* Scaled-down width for Shorts-like thumbnail */
  height: 355px; /* 9:16 aspect ratio (200 * 16/9 ≈ 355) */
  overflow: hidden;
  border-radius: 10px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  transition: transform 0.2s;
}

.thumbnailContainer:hover {
  transform: scale(1.05);
}

.thumbnail {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.videoTitle {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 10px;
  font-size: 14px;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


.thumbnailRow {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  margin: 20px 0;
  white-space: nowrap;
  max-width: 100%;
  scroll-behavior: smooth;
}
.thumbnailItem {
  cursor: pointer;
  text-align: center;
  flex-shrink: 0; /* Keeps dimensions fixed */
}
.thumbnailImage {
  width: 100px;
  height: 100px;
  object-fit: cover;
}
.thumbnailTitle {
  font-size: 12px;
  margin: 5px 0 0;
  max-width: 100px; /* Matches thumbnail width */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cropButtonsRow {
  display: flex;
  overflow-x: auto;
  gap: 10px;
  margin: 10px 0;
  white-space: nowrap;
}
.cropButton {
  padding: 5px 10px;
  background-color: #0070f3;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}